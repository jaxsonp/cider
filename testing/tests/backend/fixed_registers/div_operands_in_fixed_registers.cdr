//! EXIT_CODE=64

// on x86-64 the third and fourth arguments arrive in rdx and rcx. division overwrites eax and edx, so a dividend
// sitting in edx has to be saved and moved to eax first, and both arguments are still used afterwards
fn f(a: u32, b: u32, c: u32, d: u32) -> u32 {
	(c / d) + (d % c) + (c % d) + c - d + a - b
}

fn main() -> u32 {
	return f(10u32, 4u32, 50u32, 7u32);
}

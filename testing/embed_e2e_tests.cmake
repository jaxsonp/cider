# Embeds every .cdr file under E2E_DIR into a cpp source file at OUTPUT, defining
# get_e2e_test_files(), declared in src/e2e_testing.hpp
#
# Usage:
#   cmake -DE2E_DIR=<dir> -DOUTPUT=<file.cpp> -P embed_e2e_tests.cmake


file(GLOB_RECURSE files RELATIVE "${E2E_DIR}" "${E2E_DIR}/*.cdr")
list(SORT files)

set(out "// Generated by tests/embed_e2e_tests.cmake, do not edit\n")
string(APPEND out "#include \"e2e_testing.hpp\"\n\n")
string(APPEND out "namespace testing::e2e\n{\n\tconst std::vector<E2eTest> e2e_tests = {\n")
foreach(file IN LISTS files)
	file(READ "${E2E_DIR}/${file}" contents)
	string(RANDOM LENGTH 10 rand_chars)
	set(delim "cdr_${rand_chars}")
	string(APPEND out "\t\t{\"${file}\", R\"${delim}(${contents})${delim}\"},\n")
endforeach()
string(APPEND out "\t};\n}\n\n")

# only touch the output if it changed, so unrelated rebuilds don't recompile it
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" old)
	if(old STREQUAL out)
		return()
	endif()
endif()
file(WRITE "${OUTPUT}" "${out}")

//! EXIT_CODE=1
//! REQUIRES=64bit

// more values than there are registers, each one needing all 8 bytes of its spill slot
fn main() -> bool {
	return 5000000000u64 + 6000000007u64 + 7000000014u64 + 8000000021u64 + 9000000028u64 + 10000000035u64 + 11000000042u64 + 12000000049u64 + 13000000056u64 + 14000000063u64 + 15000000070u64 + 16000000077u64 + 17000000084u64 + 18000000091u64 + 19000000098u64 + 20000000105u64 + 21000000112u64 + 22000000119u64 + 23000000126u64 + 24000000133u64 == 290000001330u64;
}

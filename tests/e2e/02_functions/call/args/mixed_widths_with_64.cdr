//! EXIT_CODE=1
//! REQUIRES=64bit

// narrow and wide arguments side by side, each has to arrive extended according to its own type
fn check(a: i8, b: u64, c: i16, d: i64, e: u8, f: u32, g: bool, h: i32, i: i64, j: u8, k: u64) -> bool {
	(((a == -5i8) == (b == 18446744073709551615u64)) == ((c == -300i16) == (d == -5000000000i64))) == ((((e == 200u8) == (f == 4000000000u32)) == (g == (h == -7i32))) == ((i == -1i64) == ((j == 255u8) == (k == 4294967296u64))))
}

fn main() -> bool {
	return check(-5i8, 18446744073709551615u64, -300i16, -5000000000i64, 200u8, 4000000000u32, true, -7i32, -1i64, 255u8, 4294967296u64);
}

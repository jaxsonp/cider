program = top_level_decl* ;

top_level_decl = function_definition
               | var_decl_stmt ;

function_definition = "fn", ident, "(", arg_definition_list, ")", [ "->", type ], block ;

arg_definition_list = [ arg_definition, { ",", arg_definition }, [ "," ] ] ;

arg_definition = pattern, ":", type ;

block = "{", block_body, "}" ;

(* An expression followed by ";" is a statement, without one it's the block's value and has to come last.
   TODO once if/blocks parse: an if_expr or block at the start of a statement ends it without a ";", like Rust.
   That keeps this LL(1), the token after it decides *)
block_body = stmt, block_body
           | expr, [ ";", block_body ]
           | (* empty *) ;

(* Statements *)
stmt = var_decl_stmt
     | return_stmt ;

var_decl_stmt = "let", pattern, ":", type, "=", expr, ";" ;

return_stmt = "return", [ expr ], ";" ;

if_expr = "if", expr, block, { "elif", expr, block }, [ "else", block ] ;

(* Patterns *)
pattern = "_" (* wildcard, binds nothing *)
        | [ "mut" ], ident ; (* binding *)

(* Expression precedence *)
expr = assignment ;

(* Has type void. Non-associative, `a = b = c` is a syntax error. Any expression parses as the left side, semantic
   analysis checks that it's a place (only mutable variables for now) *)
assignment = logical_or, [ "=", logical_or ] ;

logical_or = logical_and, { "||", logical_and } ;
logical_and = equality, { "&&", equality } ;
equality = comparison, { ("==" | "!="), comparison } ;
comparison = bitwise_or, { ("<" | ">" | "<=" | ">="), bitwise_or } ;
bitwise_or =  bitwise_xor, { "|", bitwise_xor } ;
bitwise_xor = bitwise_and, { "^", bitwise_and } ;
bitwise_and = bitshift, { "&", bitshift } ;
bitshift = additive, { ("<<" | ">>"), additive } ;
additive = multiplicative, { ("+" | "-"), multiplicative } ;
multiplicative = unary, { ("*" | "/" | "%"), unary } ;

unary = ("-" | "!" | "~"), unary
      | postfix ;

postfix = primary, { postfix_op } ;

postfix_op = "(", [ arg_list ], ")" (* function call *)
           | "[", expr, "]" ; (* array indexing *)

primary = ident
        | boolean_literal
        | integer_literal
        | if_expr (* if as expression *)
        | block (* block as expression *)
        | "(", expr, ")" ;

arg_list = expr, { ",", expr } ;

type = type_ident, [ "<", type, ">" ] ;

type_ident = "void" | "addr" | "bool" | "u8" | "u16" | "u32" | "u64" | "i8" | "i16" | "i32" | "i64" ;
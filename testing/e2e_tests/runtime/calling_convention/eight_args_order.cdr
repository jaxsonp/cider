//! EXIT_CODE=171

// each argument is one bit of the result, so any mix-up changes the answer
fn bits(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32) -> u32 {
	a * 128u32 + b * 64u32 + c * 32u32 + d * 16u32 + e * 8u32 + f * 4u32 + g * 2u32 + h
}

fn main() -> u32 {
	return bits(1u32, 0u32, 1u32, 0u32, 1u32, 0u32, 1u32, 1u32);
}

//! EXIT_CODE=9

fn pick_last(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32, i: u32, j: u32) -> u32 { j }
fn pick_ninth(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32, i: u32, j: u32) -> u32 { i }

fn main() -> u32 {
	return pick_ninth(0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 9u32, 10u32) + pick_last(0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 9u32, 0u32);
}

//! EXIT_CODE=138

// distinct weights make any swapped or misplaced stack slot change the result
fn weigh(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32, i: u32, j: u32, k: u32, l: u32) -> u32 {
	(a + b * 2u32 + c * 3u32 + d * 4u32 + e * 5u32 + f * 6u32 + g * 7u32 + h * 8u32 + i * 9u32 + j * 10u32 + k * 11u32 + l * 12u32) % 256u32
}

fn main() -> u32 {
	return weigh(1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32, 11u32, 12u32);
}

//! EXIT_CODE=55

fn inner(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32, i: u32, j: u32) -> u32 {
	a + b + c + d + e + f + g + h + i + j
}

// the callee passes its own stack-passed parameters on to another call
fn outer(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32, g: u32, h: u32, i: u32, j: u32) -> u32 {
	inner(j, i, h, g, f, e, d, c, b, a)
}

fn main() -> u32 {
	return outer(1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32);
}
